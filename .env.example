# Frontend (public) — set in src/environments/environment.ts and environment.prod.ts.
# Only the Supabase project URL and the PUBLIC anon/publishable key belong here.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-PUBLISHABLE-KEY

# NEVER place the service_role key or any OpenRouter key in frontend code.

# OpenRouter is called ONLY from the Supabase Edge Function (server-side secret):
#   supabase secrets set OPENROUTER_API_KEY=sk-or-xxxx
#   supabase secrets set APP_URL=https://your-domain

# Live isolation test (scripts/test-isolation.mjs) — optional:
# TEST_A_EMAIL / TEST_A_PASSWORD / TEST_B_EMAIL / TEST_B_PASSWORD
# TEST_COURSE_ID / TEST_VERSION_ID / TEST_DEPT_ID